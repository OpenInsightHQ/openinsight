PI_HTTP_PORT=3000
PI_API_KEY=
SKILL_REPO_DIR=/app/skill-repo
OPENCODE_API_KEY=
PI_PROVIDER=opencode
PI_MODEL=minimax-m2.5-free
# Session-lifetime runtime guards (0 = disabled). Kept at 0 on purpose: these
# are cumulative caps (tokens / model calls over the whole conversation) and a
# long conversation re-sends its context on every step, so ordinary long chats
# hit "429 session budget exceeded" and users were forced to start a new one.
# Per-turn caps and the tool-infra breaker (which actually stop runaway loops)
# are left at their code defaults.
PI_SESSION_MAX_MODEL_CALLS=0
PI_SESSION_MAX_TOKENS=0
# Skill dependency auto-install after upload (1 = default, 0 = disable)
# PI_SKILL_DEPS_AUTO_INSTALL=1
# Optional mirrors for CN environments (skill dependency installs)
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# npm_config_registry=https://registry.npmmirror.com
