#=====================================================================#
#                       DMP Configuration                       #
#=====================================================================#
# 变量来源标记：
#   [注入] install.sh 从根 env.sh 自动写入
#   [生成] 根 env.sh / common.sh 首次部署时随机生成（install.sh 回填，支持升级）
#   [默认] 本文件提供的默认值，可按需覆盖

#-------- 服务 --------
SERVER_PORT=8090                      # 容器内部端口，与 Dockerfile EXPOSE / healthcheck 对齐
APP_NAME=chatbi-api
APP_VERSION=3.0.2

#-------- MySQL -------- [注入]
DMP_MYSQL_HOST=openinsight-mysql
DMP_MYSQL_PORT=3306
DMP_MYSQL_USERNAME=root
DMP_MYSQL_PASSWORD=
DMP_DB_NAME=openinsight

#-------- Redis -------- [注入]
DMP_REDIS_HOST=openinsight-redis
DMP_REDIS_PORT=6379
DMP_REDIS_PASSWORD=
DMP_REDIS_DATABASE=11

#-------- Druid 监控 --------
# 留空则 Druid 监控页无需登录（仅内网建议留空）
DRUID_LOGIN_USERNAME=
DRUID_LOGIN_PASSWORD=

#-------- MongoDB (LibreChat) -------- [注入]
MONGODB_URI=mongodb://openinsight-mongodb:27017/LibreChat

#-------- Meilisearch -------- [注入]
MEILI_HOST=http://openinsight-meilisearch:7700
MEILI_MASTER_KEY=                     # [生成] 根 env.sh MEILI_MASTER_KEY
MEILI_INDEX_VOCALUARY=vocabulary_keyword

#-------- Quartz --------
QUARTZ_AUTO_STARTUP=false

#-------- MyBatis Plus 字段加密 -------- [生成]
# 无默认值，必填；install.sh 首次随机生成并写入根 env.sh（升级时回填）
MYBATIS_PLUS_ENCRYPTOR_PASSWORD=

#-------- License / 证书 --------
# 启用校验（CERTIFICATE_ENABLED=true）时必须填写 STORE_PASS / AES_KEY
CERTIFICATE_SUBJECT=license.lic
CERTIFICATE_STORE_PASS=
CERTIFICATE_LICENSE_PATH=/data/license/license.lic
CERTIFICATE_PUBLIC_ALIAS=chatbipubliccert
CERTIFICATE_AES_KEY=
CERTIFICATE_DATABASE_TYPE=mysql
CERTIFICATE_ENABLED=false

#-------- PI 服务 -------- [注入]
PI_HOST=
PI_API_KEY=

#-------- Agent Platform / ARP --------
AGENT_PLATFORM_BASE_URL=http://openinsight-arp:33080   # [注入] feign librechat url（application.yaml）
ARP_HOST=http://openinsight-arp:33080                  # [注入] librechat.yaml pi endpoint baseURL
ARP_API_KEY=                                           # [生成] sk- 前缀；写入 MySQL infra_api_key + Mongo agentapikeys

#-------- 初始化管理员 --------
ADMIN_INIT_NAME=管理员
ADMIN_INIT_USERNAME=chatbi
# 管理员密码（明文）。留空时系统首次启动随机生成 16 位密码，并在 dmp-api 日志打印，请尽快登录修改。
# 该密码同时用于 DMP（MySQL）与 ARP（MongoDB）管理员账号，需保持一致。
ADMIN_INIT_PASSWORD=Chatbi.123
ADMIN_INIT_TENANT_ID=163
ADMIN_INIT_EMAIL_SUFFIX=example.com
# 调用 /open-api/system/user/get-by-third-party-user-id 命中不到时自动生成第三方用户
ADMIN_AUTO_GENERATE_THIRD_PARTY_USER=true

#-------- DMP --------
DMP_HOST=                              # [注入] DMP 对外 API 根地址，如 http://<HOST_IP>:30080
DMP_VERSION=2.0.2.8                    # update_sql.sh 据此判定 DB 增量脚本执行范围
DMP_API_KEY=                           # [注入] 根 env.sh 生成；init-data dmp.yaml + librechat.yaml MCP 鉴权
DMP_MCP_URL=http://openinsight-dmp-api:8090/open-api/mcp   # [注入] ARP 经此调用 DMP MCP（librechat.yaml mcpServers.dmp）
DMP_REPORT_DOWNLOAD_LINK_MODE=proxy    # proxy：DMP 代理下载；presign：对象存储预签名直链
DMP_REPORT_TOKEN_SECRET=               # [注入] 根 env.sh STANDARD_REPORT_DOWNLOAD_TOKEN_SECRET 生成
DMP_REPORT_TOKEN_EXPIRE_DAYS=3

#=====================================================================#
# 以下为 docker-compose 编排变量（非 app 读取）
#=====================================================================#
# DMP 镜像 tag：latest 跟随主干；v2.0.2 对应 git tag。改后执行 bash install.sh
DMP_IMAGE_TAG=latest
# 对外暴露的 Web 端口
DMP_PUBLIC_WEB_PORT=30080
